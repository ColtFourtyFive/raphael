# Copy to .env and fill in. Never commit .env.

# Mode safety
ALLOW_LIVE_TRADING=false

# Alpaca (paper first: https://paper-api.alpaca.markets)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex

# AI (via LiteLLM proxy)
ANTHROPIC_API_KEY=
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=
AI_MODEL=claude-haiku-5-5

# Infrastructure (local defaults)
DATABASE_URL=postgresql+psycopg://atp:atp@localhost:5432/atp
NATS_URL=nats://localhost:4222

# Control panel
ADMIN_TOKEN=

# Credentials encryption (local dev key; KMS key ARN in AWS)
LOCAL_ENCRYPTION_KEY=
AWS_KMS_KEY_ARN=

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
